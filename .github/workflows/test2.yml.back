name: Test Slack Notification

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  test-deployment:
    runs-on: ubuntu-latest

    steps:

      # ╔══════════════════════════════════════╗
      # ║        🚀  DEPLOYMENT STARTED        ║
      # ╚══════════════════════════════════════╝
      - name: Notify Slack — Started
        uses: slackapi/slack-github-action@v2.1.1
        with:
          webhook: ${{ secrets.SLACK_WEBHOOK_URL }}
          webhook-type: incoming-webhook
          payload: |
            attachments:
              - color: "#0F62FE"
                blocks:

                  - type: section
                    text:
                      type: mrkdwn
                      text: |
                        :rocket:  *Deployment Pipeline Started*

                  - type: divider

                  - type: section
                    fields:
                      - type: mrkdwn
                        text: ":file_folder:  *Project*\n${{ github.repository }}"
                      - type: mrkdwn
                        text: ":twisted_rightwards_arrows:  *Branch*\n`${{ github.ref_name }}`"
                      - type: mrkdwn
                        text: ":bust_in_silhouette:  *Triggered by*\n${{ github.actor }}"
                      - type: mrkdwn
                        text: ":hash:  *Run*\n#${{ github.run_number }}"

                  - type: divider

                  - type: section
                    text:
                      type: mrkdwn
                      text: |
                        *Pipeline Steps*
                        :white_circle:  `Setup`   →   :white_circle:  `Build`   →   :white_circle:  `Test`   →   :white_circle:  `Deploy`

                  - type: context
                    elements:
                      - type: mrkdwn
                        text: ":github:  <${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|View on GitHub Actions>  ·  Commit `${{ github.sha }}`"


      # ───────────────────────────────────────────
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Step 1 — Setup
        run: |
          echo "Setting up environment..."
          sleep 2
        # exit 1   ← uncomment to simulate failure

      - name: Step 2 — Build
        run: |
          echo "Building application..."
          sleep 2

      - name: Step 3 — Test
        run: |
          echo "Running tests..."
          sleep 2

      - name: Step 4 — Deploy
        run: |
          echo "Deploying application..."
          sleep 2
          echo "Done!"


      # ╔══════════════════════════════════════╗
      # ║        📋  DEPLOYMENT RESULT         ║
      # ╚══════════════════════════════════════╝
      - name: Notify Slack — Result
        if: always()
        uses: slackapi/slack-github-action@v2.1.1
        with:
          webhook: ${{ secrets.SLACK_WEBHOOK_URL }}
          webhook-type: incoming-webhook
          payload: |
            attachments:
              - color: "${{ job.status == 'success' && '#24A148' || job.status == 'failure' && '#DA1E28' || '#F1C21B' }}"
                blocks:

                  - type: section
                    text:
                      type: mrkdwn
                      text: "${{ job.status == 'success' && ':large_green_circle:' || job.status == 'failure' && ':red_circle:' || ':large_yellow_circle:' }}  *Deployment ${{ job.status == 'success' && 'Succeeded' || job.status == 'failure' && 'Failed' || 'Cancelled' }}*"

                  - type: divider

                  - type: section
                    fields:
                      - type: mrkdwn
                        text: ":file_folder:  *Project*\n${{ github.repository }}"
                      - type: mrkdwn
                        text: ":twisted_rightwards_arrows:  *Branch*\n`${{ github.ref_name }}`"
                      - type: mrkdwn
                        text: ":bust_in_silhouette:  *Author*\n${{ github.actor }}"
                      - type: mrkdwn
                        text: ":hash:  *Run*\n#${{ github.run_number }}"
                      - type: mrkdwn
                        text: ":label:  *Commit*\n`${{ github.sha }}`"
                      - type: mrkdwn
                        text: ":stopwatch:  *Status*\n`${{ job.status }}`"

                  - type: divider

                  - type: section
                    text:
                      type: mrkdwn
                      text: |
                        *Pipeline Result*
                        ${{ job.status == 'success' && ':large_green_circle:  `Setup`   →   :large_green_circle:  `Build`   →   :large_green_circle:  `Test`   →   :large_green_circle:  `Deploy`' || job.status == 'failure' && ':large_green_circle:  `Setup`   →   :large_green_circle:  `Build`   →   :large_green_circle:  `Test`   →   :red_circle:  `Deploy`' || ':white_circle:  `Setup`   →   :white_circle:  `Build`   →   :white_circle:  `Test`   →   :white_circle:  `Deploy`' }}

                  - type: divider

                  - type: section
                    text:
                      type: mrkdwn
                      text: "${{ job.status == 'success' && ':tada:  All steps passed. Your changes are now live in production.' || job.status == 'failure' && ':mag:  A step failed. Review the logs to diagnose and fix the issue.' || ':octagonal_sign:  The workflow was cancelled before it could complete.' }}"

                  - type: actions
                    elements:
                      - type: button
                        text:
                          type: plain_text
                          text: "📋  View Logs"
                          emoji: true
                        url: "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
                        style: "${{ job.status == 'success' && 'primary' || 'danger' }}"
                      - type: button
                        text:
                          type: plain_text
                          text: "🔖  Browse Commit"
                          emoji: true
                        url: "${{ github.server_url }}/${{ github.repository }}/commit/${{ github.sha }}"
                      - type: button
                        text:
                          type: plain_text
                          text: "📂  Open Repo"
                          emoji: true
                        url: "${{ github.server_url }}/${{ github.repository }}"

                  - type: context
                    elements:
                      - type: mrkdwn
                        text: ":github:  *GitHub Actions*  ·  Workflow: `${{ github.workflow }}`  ·  Run #${{ github.run_number }}"
